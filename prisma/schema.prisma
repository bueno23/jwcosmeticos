// JW Cosméticos — estrutura pensada para virar SaaS multiempresa: tudo pendurado em Company
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  DONO
  GERENTE
  OPERADOR
}

enum MovementType {
  ENTRADA
  SAIDA
  AJUSTE
  VENDA
  CANCELAMENTO
  PERDA
}

enum PaymentMethod {
  DINHEIRO
  PIX
  DEBITO
  CREDITO
  FIADO
}

enum SaleStatus {
  CONCLUIDA
  CANCELADA
}

enum CashStatus {
  ABERTO
  FECHADO
}

enum CashMovementType {
  ABERTURA
  VENDA
  SANGRIA
  SUPRIMENTO
  DESPESA
  FECHAMENTO
}

enum PayableStatus {
  ABERTA
  PAGA
  VENCIDA
  CANCELADA
}

model Company {
  id        String   @id @default(cuid())
  name      String
  tagline   String?
  document  String?
  phone     String?
  address   String?
  createdAt DateTime @default(now())

  users        User[]
  categories   Category[]
  products     Product[]
  suppliers    Supplier[]
  customers    Customer[]
  sales        Sale[]
  movements    StockMovement[]
  registers    CashRegister[]
  expenses     Expense[]
  revenues     Revenue[]
  payables     AccountPayable[]
  receivables  AccountReceivable[]
  financeCats  FinanceCategory[]
}

model User {
  id           String   @id @default(cuid())
  companyId    String
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(OPERADOR)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  company   Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sales     Sale[]
  movements StockMovement[]
  registers CashRegister[]
  cashMoves CashMovement[]

  @@index([companyId])
}

model Category {
  id        String   @id @default(cuid())
  companyId String
  name      String
  color     String   @default("#F5C518")
  createdAt DateTime @default(now())

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([companyId, name])
}

model Supplier {
  id           String   @id @default(cuid())
  companyId    String
  legalName    String
  tradeName    String?
  document     String?
  phone        String?
  email        String?
  address      String?
  contactName  String?
  createdAt    DateTime @default(now())

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products Product[]
  payables AccountPayable[]

  @@index([companyId])
}

model Product {
  id          String   @id @default(cuid())
  companyId   String
  categoryId  String?
  supplierId  String?
  name        String
  sku         String?
  barcode     String?
  brand       String?
  description String?
  unit        String   @default("un")
  costPrice   Decimal  @default(0) @db.Decimal(12, 2)
  salePrice   Decimal  @default(0) @db.Decimal(12, 2)
  stock       Int      @default(0)
  minStock    Int      @default(0)
  trackStock  Boolean  @default(true)
  imageUrl    String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company   Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category  Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  supplier  Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  saleItems SaleItem[]
  movements StockMovement[]

  @@unique([companyId, sku])
  @@index([companyId, active])
}

model Customer {
  id        String    @id @default(cuid())
  companyId String
  name      String
  phone     String?
  document  String?
  birthDate DateTime?
  notes     String?
  createdAt DateTime  @default(now())

  company     Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sales       Sale[]
  receivables AccountReceivable[]

  @@index([companyId])
}

model Sale {
  id         String        @id @default(cuid())
  companyId  String
  userId     String?
  customerId String?
  registerId String?
  number     Int
  status     SaleStatus    @default(CONCLUIDA)
  payment    PaymentMethod
  subtotal   Decimal       @db.Decimal(12, 2)
  discount   Decimal       @default(0) @db.Decimal(12, 2)
  total      Decimal       @db.Decimal(12, 2)
  costTotal  Decimal       @db.Decimal(12, 2)
  paid       Boolean       @default(true)
  paidAt     DateTime?
  canceledAt DateTime?
  createdAt  DateTime      @default(now())

  company     Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user        User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  customer    Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  register    CashRegister?       @relation(fields: [registerId], references: [id], onDelete: SetNull)
  items       SaleItem[]
  movements   StockMovement[]
  receivables AccountReceivable[]

  @@unique([companyId, number])
  @@index([companyId, createdAt])
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  productId String?
  name      String
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)
  unitCost  Decimal @db.Decimal(12, 2)
  total     Decimal @db.Decimal(12, 2)

  sale    Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([saleId])
}

// Nenhum estoque muda sem uma linha aqui: esta tabela é a auditoria do estoque
model StockMovement {
  id        String       @id @default(cuid())
  companyId String
  productId String
  userId    String?
  saleId    String?
  type      MovementType
  quantity  Int
  unitCost  Decimal?     @db.Decimal(12, 2)
  totalCost Decimal?     @db.Decimal(12, 2)
  balance   Int
  reason    String?
  origin    String?
  createdAt DateTime     @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  sale    Sale?   @relation(fields: [saleId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([productId, createdAt])
}

model CashRegister {
  id            String     @id @default(cuid())
  companyId     String
  userId        String?
  status        CashStatus @default(ABERTO)
  openingAmount Decimal    @db.Decimal(12, 2)
  closingAmount Decimal?   @db.Decimal(12, 2)
  expectedAmount Decimal?  @db.Decimal(12, 2)
  difference    Decimal?   @db.Decimal(12, 2)
  openedAt      DateTime   @default(now())
  closedAt      DateTime?
  notes         String?

  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  sales     Sale[]
  movements CashMovement[]

  @@index([companyId, openedAt])
}

model CashMovement {
  id          String           @id @default(cuid())
  registerId  String
  userId      String?
  type        CashMovementType
  amount      Decimal          @db.Decimal(12, 2)
  description String?
  createdAt   DateTime         @default(now())

  register CashRegister @relation(fields: [registerId], references: [id], onDelete: Cascade)
  user     User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([registerId, createdAt])
}

model FinanceCategory {
  id        String  @id @default(cuid())
  companyId String
  name      String
  kind      String // despesa | receita
  createdAt DateTime @default(now())

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  expenses Expense[]
  revenues Revenue[]

  @@unique([companyId, name, kind])
}

model Expense {
  id          String   @id @default(cuid())
  companyId   String
  categoryId  String?
  description String
  amount      Decimal  @db.Decimal(12, 2)
  spentAt     DateTime
  createdAt   DateTime @default(now())

  company  Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category FinanceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([companyId, spentAt])
}

model Revenue {
  id          String   @id @default(cuid())
  companyId   String
  categoryId  String?
  description String
  amount      Decimal  @db.Decimal(12, 2)
  receivedAt  DateTime
  createdAt   DateTime @default(now())

  company  Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category FinanceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([companyId, receivedAt])
}

model AccountPayable {
  id          String        @id @default(cuid())
  companyId   String
  supplierId  String?
  description String
  amount      Decimal       @db.Decimal(12, 2)
  dueDate     DateTime
  paidAt      DateTime?
  status      PayableStatus @default(ABERTA)
  createdAt   DateTime      @default(now())

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@index([companyId, dueDate])
}

model AccountReceivable {
  id          String        @id @default(cuid())
  companyId   String
  customerId  String?
  saleId      String?
  description String
  amount      Decimal       @db.Decimal(12, 2)
  dueDate     DateTime
  paidAt      DateTime?
  status      PayableStatus @default(ABERTA)
  createdAt   DateTime      @default(now())

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  sale     Sale?     @relation(fields: [saleId], references: [id], onDelete: SetNull)

  @@index([companyId, dueDate])
}
